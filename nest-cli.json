{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "entryFile": "main",
    "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "tsconfig.build.json",
        "plugins": [
            {
                "name": "../../../scripts/nest-library-freshness.cjs",
                "options": {
                    "consumer": "apps/brobot",
                    "tsconfig": "tsconfig.build.json"
                }
            }
        ],
        "assets": [],
        "watchAssets": false
    }
}
