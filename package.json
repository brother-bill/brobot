{
    "name": "@singularity/brobot",
    "version": "2.0.0",
    "private": true,
    "description": "brobot — Twitch bot + API for the bro_____bot channel, rebuilt on NestJS 11 + MikroORM",
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "test:integration": "vitest run --config vitest.config.integration.ts --passWithNoTests",
        "db:schema:dev": "mikro-orm schema:update --run"
    },
    "dependencies": {
        "@mikro-orm/cli": "^6.6.14",
        "@mikro-orm/core": "^6.6.14",
        "@mikro-orm/migrations": "^6.6.14",
        "@mikro-orm/nestjs": "^6.1.2",
        "@mikro-orm/postgresql": "^6.6.14",
        "@nestjs/common": "^11.1.24",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.24",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-express": "^11.1.24",
        "@nestjs/platform-ws": "^11.1.24",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.24",
        "@twurple/auth": "^8.2.0",
        "cookie-parser": "^1.4.7",
        "express": "^4.22.2",
        "helmet": "^8.1.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "catalog:",
        "tslib": "^2.3.0",
        "ws": "^8.18.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.1.24",
        "@testcontainers/postgresql": "^11.14.0",
        "@types/express": "^4.17.25",
        "@types/supertest": "^7.2.0",
        "@types/ws": "^8.5.12",
        "supertest": "^7.2.2",
        "testcontainers": "^11.14.0"
    },
    "mikro-orm": {
        "useTsNode": true,
        "tsConfigPath": "./tsconfig.app.json",
        "configPaths": [
            "./src/mikro-orm.config.ts",
            "./dist/mikro-orm.config.js"
        ]
    }
}
