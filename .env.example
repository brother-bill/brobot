# brobot API environment. Copy to .env for local development (production
# injects these from the `brobot-prod` GitHub Environment; values never live
# in this repo). Validated at boot by src/config/env.schema.ts: a missing or
# malformed required variable stops the process and names the variable.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Optional, default 3000.
PORT=3000
# Optional, default true. false skips migrator.up() at boot.
RUN_MIGRATIONS=true

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://brobot:brobot@localhost:5432/brobot

# ── Public surface ───────────────────────────────────────────────────────
# Public hostname of this API — the EventSub callback host. No scheme.
DOMAIN=admin.brobot.live
# Where the OAuth callbacks send the browser. Its origin must be in ALLOWED_ORIGINS.
UI_URL=https://brobot.live
# Comma-separated bare origins (scheme://host[:port], no path). At least one.
ALLOWED_ORIGINS=https://brobot.live

# ── brobot's own auth ────────────────────────────────────────────────────
# ≥ 32 characters each, and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Shared with api-time (its backend env holds the same value). ≥ 32 characters.
BROBOT_SERVICE_TOKEN=

# ── Twitch application ───────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_URL_USER=https://admin.brobot.live/api/auth/twitch/callback
TWITCH_CALLBACK_URL_STREAMER=https://admin.brobot.live/api/auth/twitch/streamer/callback
TWITCH_CALLBACK_URL_BOT=https://admin.brobot.live/api/auth/twitch/bot/callback
# Numeric Twitch user ids. Only these accounts may complete the streamer / bot flows.
TWITCH_STREAMER_OAUTH_ID=
TWITCH_BOT_OAUTH_ID=
TWITCH_STREAMER_CHANNEL_LISTEN=
TWITCH_BOT_USERNAME=
# 10–100 characters (Twurple's EventSub requirement).
EVENT_SUB_SECRET=

# Secret the streamer client presents on /api/ashketchum. ≥ 16 characters.
WS_SECRET=

# ── The bot ──────────────────────────────────────────────────────────────
# Optional, default true. false keeps chat, drops and redeems offline (API only).
TWITCH_BOT_ENABLED=true
# Optional, default false. true mounts the EventSub webhook on /twitch/* and
# subscribes to channel-point redemptions + raids. Production only: Twitch must
# reach https://$DOMAIN/twitch/ on 443.
TWITCH_EVENTSUB_ENABLED=false

# ── Integrations (optional — unset disables the feature) ─────────────────
RIOT_API_KEY=
LICHESS_AUTH_TOKEN=
OPEN_API_KEY=
# Optional, default gpt-4o-mini. The model behind the @bot reply.
OPENAI_MODEL=
STREAMLABS_CLIENT_ID=
STREAMLABS_SECRET=
STREAMLABS_REDIRECT_URI=

# ── Retired: listed so the old .env maps across; brobot no longer reads them ─
# SESSION_SECRET=   (express-session is gone; JWT_* replace it)
# AWS_USER=         (deploy-only, EC2 — retired by I1)
# AWS_PUBLIC_IP=
# AWS_SSH_KEY=
# AWS_EC2_PATH=
