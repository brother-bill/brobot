{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Build output. rootDir lives in tsconfig.build.json: this config reads
        // @singularity/http-contract from source (tsconfig.base.json's `paths`),
        // which sits outside ./src and would otherwise fail TS6059.
        "outDir": "./dist",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "node_modules", "test", "dist"]
}
